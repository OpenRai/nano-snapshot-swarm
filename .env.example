# Producer configuration. Copy to ~/.env on the producer host and set secrets
# there; never commit the resulting file.
DHT_PRIVATE_KEY=
DHT_SALT=daily
OUTPUT_DIR=/home/openrai/nano-snapshots
USE_PLACEHOLDER_SNAPSHOT=false
SNAPSHOT_RETENTION_COUNT=0
METRICS_ENABLED=true

# Optional Grafana Cloud Prometheus remote write.
# Leave GRAFANA_CLOUD_PROMETHEUS_REMOTE_WRITE_URL empty to completely bypass the
# local Grafana Alloy scrape-and-push service. The producer's loopback metrics
# endpoint remains available independently at http://127.0.0.1:9108/metrics.
GRAFANA_CLOUD_PROMETHEUS_REMOTE_WRITE_URL=
GRAFANA_CLOUD_PROMETHEUS_INSTANCE_ID=
GRAFANA_CLOUD_PROMETHEUS_WRITE_TOKEN=

# Optional Alloy watchdog settings. The defaults require 5 GiB free on /,
# restart a stale remote-write queue after 10 minutes, and permit at most one
# automatic restart per hour. A disk-full condition is reported but never
# triggers a restart, because only space reclamation can repair it.
OBSERVABILITY_MIN_FREE_BYTES=5368709120
OBSERVABILITY_REMOTE_WRITE_STALE_SECONDS=600
OBSERVABILITY_RESTART_COOLDOWN_SECONDS=3600
