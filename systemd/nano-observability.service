[Unit]
Description=Nano Snapshot Swarm Grafana Alloy collector
After=network-online.target nano-seed.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.env
# A non-zero ExecCondition skips this optional unit without running Alloy.
ExecCondition=/usr/bin/test -n ${GRAFANA_CLOUD_PROMETHEUS_REMOTE_WRITE_URL}
ExecStart=/usr/bin/alloy run %h/nano-snapshot-swarm/observability/nano-snapshot-swarm.alloy --storage.path=%h/.local/state/nano-alloy
WorkingDirectory=%h/nano-snapshot-swarm
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nano-observability

[Install]
WantedBy=default.target
