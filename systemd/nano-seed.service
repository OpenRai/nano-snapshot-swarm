[Unit]
Description=Nano P2P Snapshot Seeder (libtorrent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.env
Environment=OUTPUT_DIR=%h/nano-snapshots
Environment=LOG_LEVEL=INFO
Environment=DHT_PUT_HELPER=%h/nano-snapshot-swarm/bin/nano-dht-put
ExecStartPre=%h/nano-snapshot-swarm/scripts/build-dht-put-helper.sh
ExecStart=%h/nano-snapshot-swarm/.venv/bin/python -m producer.seeder
WorkingDirectory=%h/nano-snapshot-swarm
Restart=on-failure
RestartSec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nano-seed
# Seeder is low priority — don't let it block snapshot pipeline
Nice=10

[Install]
WantedBy=default.target
